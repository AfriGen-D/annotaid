# AnnotAid server settings. Install as /etc/annotaid/env
#   owner root:annotaid, mode 0640  (it holds the OpenRouter key)
# Restart the service after editing:  systemctl restart annotaid

# --- AI extraction (one institutional key; users never see it) ------------- #
OPENROUTER_API_KEY=

# --- literature services (optional but recommended) ------------------------ #
# An NCBI key raises the E-utilities rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
# Unpaywall asks callers to identify themselves with an email address.
UNPAYWALL_EMAIL=

# --- first superadmin --------------------------------------------------------- #
# Used ONLY when no active superadmin exists (i.e. first start). That account
# must change this password at first login, after which these two lines do
# nothing; you may blank the password then. Minimum 10 characters.
ANNOTAID_ADMIN_EMAIL=
ANNOTAID_ADMIN_PASSWORD=
ANNOTAID_ADMIN_NAME=

# --- web --------------------------------------------------------------------- #
# Requests are accepted from the site's own address automatically (nginx
# passes Host). Only list extra origins here if a request legitimately comes
# from a DIFFERENT hostname. Usually leave empty.
ANNOTAID_ALLOWED_ORIGINS=
# auto: the session cookie is marked Secure whenever nginx reports HTTPS.
ANNOTAID_COOKIE_SECURE=auto
