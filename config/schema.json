{
  "features": [
    {
      "name": "geographical_region",
      "label": "Geographical Region",
      "type": "string",
      "nullable": true,
      "description": "Broad geographical origin of the study participants."
    },
    {
      "name": "mixed_population",
      "label": "Mixed Population",
      "type": "enum",
      "enumValues": [
        "Yes",
        "No",
        "Unclear"
      ],
      "nullable": true,
      "description": "Whether participants represent multiple countries, ancestries, or populations (Yes, No, or Unclear)."
    },
    {
      "name": "variants",
      "type": "group",
      "label": "Variants",
      "description": "Group association results by each reported genetic variant identifier (RSID).",
      "min": 0,
      "maxItems": 50,
      "features": [
        {
          "name": "gene_symbol",
          "label": "Gene Symbol",
          "type": "string",
          "nullable": true,
          "description": "Standardized gene symbol associated with the rsID."
        },
        {
          "name": "p_value",
          "label": "P Value",
          "type": "string",
          "nullable": true,
          "description": "Statistical significance value reported for the variant association."
        }
      ]
    }
  ],
  "models": [
    {
      "slug": "openai/gpt-oss-20b:free",
      "label": "openai_gpt-oss",
      "supportsStructuredOutput": true
    },
    {
      "slug": "deepseek/deepseek-v4-flash",
      "label": "deepseek_deepseek-v4",
      "supportsStructuredOutput": true
    },
    {
      "slug": "anthropic/claude-opus-4.7",
      "label": "anthropic_claude-opus-4.7"
    }
  ],
  "prompts": [
    {
      "label": "default",
      "file": "prompt.default.txt"
    }
  ],
  "parseEngines": [
    "pdf-text",
    "mistral-ocr",
    "native"
  ],
  "defaults": {
    "parseEngine": "pdf-text"
  },
  "export": {
    "csv": {
      "rowScope": "variants",
      "includeHeaderRow": true,
      "arrayDelimiter": "; ",
      "boolTrue": "TRUE",
      "boolFalse": "FALSE",
      "nullText": "",
      "columns": [
        {
          "header": "PMID",
          "source": "pmid"
        },
        {
          "header": "Geographical Region",
          "source": "geographical_region"
        },
        {
          "header": "Mixed Population",
          "source": "mixed_population"
        },
        {
          "header": "RSID",
          "source": "variants.$label"
        },
        {
          "header": "Gene Symbol",
          "source": "variants.gene_symbol"
        },
        {
          "header": "P Value",
          "source": "variants.p_value"
        }
      ]
    }
  },
  "settings": {
    "allowPapersWithoutPmid": false,
    "allowExtractionOnAbstract": false
  }
}
